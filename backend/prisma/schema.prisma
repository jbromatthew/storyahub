  kind          String
  sheetName     String
  spreadsheetId String
  status        String
  added         Int      @default(0)
  updated       Int      @default(0)
  deleted       Int      @default(0)
  rowCount      Int      @default(0)
  errorMessage  String?
  syncedById    String?
  createdAt     DateTime @default(now())

  @@index([kind, sheetName, createdAt])
}

/// 세일즈 계기판 목표 (앱에서 수정한 값 — 시트 기본값 위에 덮어씀)
model ErpSalesDashboardGoalSet {
  month                String   @id
  industryGoals        Json     @default("{}")
  industryPlanGoals    Json     @default("{}")
  industryChannelGoals Json     @default("{}")
  updatedById          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

/// 공사(견적) 관리 — 소유자 전용
model ErpConstructionItem {
  id        String   @id @default(cuid())
  name      String
  unitPrice Int      @default(0)
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ErpConstructionApartment {
  id        String                 @id @default(cuid())
  name      String
  address   String?
  partner   String?
  note      String?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  quotes    ErpConstructionQuote[]
}

model ErpConstructionQuote {
  id               String                     @id @default(cuid())
  apartmentId      String?
  apartment        ErpConstructionApartment?  @relation(fields: [apartmentId], references: [id], onDelete: SetNull)
  title            String?
  orderType        String                     @default("아파트너") // 공사 구분: 아파트너 | 브로제이
  lines            Json                       @default("[]") // [{name, unitPrice, qty}]
  startDate        String? // 공사 예정 시작일 (YYYY-MM-DD)
  endDate          String? // 공사 종료일 (YYYY-MM-DD)
  status           String                     @default("requested") // requested | confirmed | ongoing | done | billing | settled
  taxInvoiceIssued Boolean                    @default(false)
  taxInvoiceDate   String? // 세금계산서 발행일자 (YYYY-MM-DD)
  taxInvoiceNo     String? // 세금계산서 승인번호
  payouts          Json                       @default("[]") // 협력업체 재정산: [{teamId, teamName, amount, paid, memo}]
  materials        Json                       @default("[]") // 투입 부품/자재 원가: [{stockId, name, qty, unitCost}]
  complaints       Json                       @default("[]") // 민원: [{date, content, status, resolution}]
  sitePhotos       Json                       @default("[]") // 개소별 현장 사진: [{name, beforeKey, afterKey, beforeBy, afterBy}]
  siteCount        Int                        @default(0) // 개소 수 (리스트에서 직접 입력)
  shareToken       String?                    @unique // 현장 업로드 공유 링크 토큰
  sharePin         String? // 공유 링크 PIN (4자리)
  shareEnabled     Boolean                    @default(false)
  shareExpiresAt   DateTime?
  surveyRequest    Json? // 실사 요청: {requestType, evLink, hopeDate, content, note}
  surveyResult     Json? // 실사 결과: {visitDate, findings, items: [{itemId, name, qty}], by, at}
  surveyToken      String?                    @unique // 설치팀 실사 입력 링크 토큰
  surveyPin        String? // 실사 링크 PIN (4자리)
  surveyEnabled    Boolean                    @default(false)
  surveyExpiresAt  DateTime?
  note             String?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  stockMoves       ErpConstructionStockMove[]

  @@index([status])
}

model ErpConstructionTeam {
  id          String   @id @default(cuid())
  name        String
  contact     String?
  note        String?
  bizRegNo    String?
  ceoName     String?
  ceoTitle    String?
  ceoPhone    String?
  address     String?
  bizType     String?
  bizItem     String?
  taxEmail    String?
  bankAccount String?
  employees   String   @default("[]")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model ErpConstructionStock {
  id        String                     @id @default(cuid())
  name      String
  unit      String                     @default("개")
  note      String?
  active    Boolean                    @default(true)
  createdAt DateTime                   @default(now())
  moves     ErpConstructionStockMove[]
}

model ErpConstructionStockMove {
  id          String                @id @default(cuid())
  stockId     String
  stock       ErpConstructionStock  @relation(fields: [stockId], references: [id], onDelete: Cascade)
  quoteId     String? // 공사 확정 자동 차감 출처 견적 (수동 기록은 null)
  quote       ErpConstructionQuote? @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  date        String // YYYY-MM-DD
  kind        String                @default("in") // in(입고/매입) | out(출고/사용)
  qty         Int                   @default(0)
  unitPrice   Int? // 매입 단가 (입고)
  vatSeparate Boolean               @default(true) // 부가세 별도 여부
  memo        String?
  createdAt   DateTime              @default(now())

  @@index([stockId])
  @@index([quoteId])
}

// 상담자료(매크로) 컨펌 — 세일즈팀 등록, CEO/COO 승인 체크
model ErpConsultDoc {
  id          String    @id @default(cuid())
  title       String // 매크로명
  note        String? // 링크·메모
  authorId    String
  authorName  String
  authorEmail String
  cooApproved Boolean   @default(false) // 승인은 COO 단독 (CEO 단계 폐지)
  cooAt       DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([createdAt])
  @@index([authorEmail])
}

// 브로제이 설치일정 (아파트너와 완전 별개, 시트 동기화 없이 앱에서 직접 관리)
model ErpInstallSchedule {
  id          String   @id @default(cuid())
  month       String // 월 탭 (예: "2025.09")
  installDate String? // 시공일 YYYY-MM-DD (정렬용)
  centerName  String? // 센터명 (검색용)
  data        Json     @default("{}") // 나머지 필드(구분·요금제·키오스크·연락처·정산 등)
  sortIndex   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([month])
}

// 일일보고 — CEO/COO 전용 (날짜별 3문답)
model ErpDailyReport {
  id          String   @id @default(cuid())
  date        String // YYYY-MM-DD
  authorId    String
  authorName  String
  authorEmail String
  did         String   @default("") // 오늘 무슨 일을 하였나
  missed      String   @default("") // 오늘 했어야 했는데 못했나
  plan        String   @default("") // 내일은 무슨 일을 할 것인가
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date, authorEmail])
  @@index([date])
}

// 일일보고 항목별 코멘트 스레드 (CEO/COO)
model ErpDailyComment {
  id              String   @id @default(cuid())
  reportId        String
  section         String // did | missed | plan
  itemId          String // 항목 앵커 (item id 또는 텍스트 키)
  itemText        String // 항목 텍스트 스냅샷
  parentId        String? // null = 스레드 루트, 값 있으면 답글
  authorEmail     String
  authorName      String
  body            String   @default("")
  files           Json     @default("[]") // [{key, name}]
  resolved        Boolean  @default(false) // (레거시) 이전 해결 개념 — 더 이상 사용 안 함
  important       Boolean  @default(false) // 루트에만 의미: ★ 중요 표시 → 스레드함에 남김
  notionCommentId String?  @unique // 노션에서 가져온 댓글의 원본 ID (중복 방지)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([reportId])
  @@index([important])
}

// IoT 견적 리드 — 고객이 공개 페이지에서 직접 견적 내고 상담 신청 (인스타 유입)
model ErpIotLead {
  id           String   @id @default(cuid())
  centerName   String
  industry     String   @default("")
  usesBroj     Boolean  @default(false)
  address      String   @default("")
  phone        String
  pyeong       Int      @default(0)
  networkSize  String   @default("small") // small | medium | large
  acCount      Int      @default(0)
  speakerCount Int      @default(0)
  panelCount   Int      @default(0)
  supplyAmount Int      @default(0) // 공급가액
  totalAmount  Int      @default(0) // VAT 포함
  breakdown    Json     @default("[]") // [{label, qty, unitPrice, amount}]
  status       String   @default("new") // new | contacted | done
  memo         String?
  source       String   @default("instagram")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdAt])
  @@index([status])
}

// 협력사(크라이저) 발주 포털 — 가입 없이 PIN으로 접근
model ErpVendorPortal {
  id        String   @id // "kreiser"
  name      String
  pin       String
  active    Boolean  @default(true)
  products  Json     @default("[]") // [{id, name, unitPrice, active}]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 발주 (브로제이 → 협력사) — 선금/잔금, 세금계산서, 부분 입고 히스토리 양사 공유
model ErpVendorOrder {
  id                   String    @id @default(cuid())
  vendorId             String    @default("kreiser")
  orderDate            String // YYYY-MM-DD
  items                Json      @default("[]") // [{name, qty, unitPrice, amount}]
  totalAmount          Int       @default(0)
  prepayRate           Int       @default(30)
  prepayAmount         Int       @default(0)
  balanceAmount        Int       @default(0)
  status               String    @default("requested") // requested | approved | done | cancelled
  approvedAt           DateTime?
  expectedDelivery     String? // 크라이저가 승인 시 입력한 예상 입고일 (YYYY-MM-DD)
  prepayRequestedAt    DateTime?
  prepayPaidAt         DateTime?
  prepayTaxDate        String?
  prepayTaxNo          String? // 세금계산서 승인번호
  prepayVerified       Boolean   @default(false) // 브로제이(경영지원) 계산서 더블체크
  balanceRequestedAt   DateTime?
  balancePaidAt        DateTime?
  balanceTaxDate       String?
  balanceTaxNo         String?
  balanceVerified      Boolean   @default(false)
  balanceDeliveryDates Json      @default("[]") // 잔금 청구 시 최종 납품일자들 (분할 납품 가능)
  deliveries           Json      @default("[]") // [{date, name, qty, note, by}]
  history              Json      @default("[]") // [{at, by, text}]
  note                 String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([vendorId, createdAt])
  @@index([status])
}

model ErpInstallSettleShare {
  id        String   @id @default(cuid())
  token     String   @unique
  pin       String
  team      String // 설치팀명 (ErpInstallSchedule.data.team과 매칭)
  fromDate  String? // 공유 범위 시작 (YYYY-MM-DD) — 발급 시 보고 있던 기간만 노출
  toDate    String? // 공유 범위 끝
  payout    Json? // 지급 정산서: {deductions: [{label, amount}], payees: [{name, amount}], note}
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([team])
}

/// 메뉴 접근 제어 — 규칙이 있는 메뉴는 지정된 팀/멤버만 노출 (소유자는 항상 전체)
model ErpMenuAccess {
  id        String   @id @default(cuid())
  menuId    String   @unique
  mode      String   @default("custom") // custom (규칙 없으면 기본 노출)
  deptIds   String[] @default([])
  emails    String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 계정별 일별 접속 기록 (KST 날짜 기준, 활동 1분 단위로 hits 집계)
model ErpAccessLog {
  id      String   @id @default(cuid())
  email   String
  date    String // YYYY-MM-DD (KST)
  name    String?
  firstAt DateTime @default(now())
  lastAt  DateTime @default(now())
  hits    Int      @default(1)

  @@unique([email, date])
  @@index([date])
  @@index([email])
}

/// 클로징 관리 수정 이력 — 누가 어느 리드의 무엇을 어떻게 바꿨는지 (시트 역기록과 함께 기록)
/// 스마트상점 접수 수정 기록 — 누가·언제·무엇을 어떻게 바꿨는지
model ErpSmartStoreEditLog {
  id          String   @id @default(cuid())
  applyId     String
  roundLabel  String // 2026년 2차 (당시 값)
  center      String // 센터명 (당시 값)
  editorEmail String
  editorName  String
  field       String // stage | source | sourceDetail | status | centerName | phone | storeId | memo
  before      String
  after       String
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([applyId])
  @@index([editorEmail])
}

model ErpClosingEditLog {
  id          String   @id @default(cuid())
  leadId      String
  month       String // 문의 시트 월 (2026.08.)
  center      String // 센터명 (당시 값)
  assignee    String // 리드 응대자 (당시 값)
  editorEmail String
  editorName  String
  field       String // 상담온도 | 결제임박률 | 문의 내용 | *미도입 사유
  before      String
  after       String
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([editorEmail])
  @@index([assignee])
  @@index([leadId])
}

/// 스마트상점 기술보급사업 회차 (2026년 2차 등)
model ErpSmartStoreRound {
  id        String               @id @default(cuid())
  year      Int
  round     Int // 차수
  title     String
  guidePath String // 공개 가이드 경로 (/smartstore/2026-2.html)
  deadline  String? // 신청 마감 안내 문구
  active    Boolean              @default(true) // 공개 여부
  note      String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  applies   ErpSmartStoreApply[]

  @@unique([year, round])
}

/// 스마트상점 신청 접수 — 고객이 공개 가이드 마지막에 직접 제출
model ErpSmartStoreApply {
  id           String             @id @default(cuid())
  roundId      String
  round        ErpSmartStoreRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  // 접수는 2단계 — 시작 시 리드 정보(연락처 기준), 신청 후 사업자번호·스마트상점 ID를 채운다
  phone        String // 리드 식별 기준
  centerName   String?
  bizNo        String? // 사업자등록번호 (미오픈이면 '준비중')
  storeId      String? // 스마트상점 ID (신청 완료 후 입력)
  products     String[]           @default([]) // premium32 | wall10 — 관심 기술 (복수 선택)
  industry     String? // 헬스장 | PT샵 | 필라테스 | 체육관 | 기타
  branchCount  String? // 1 | 2 | 3-5 | 6-10 | 11+
  isCustomer   Boolean? // 현재 브로제이 서비스 이용 중인지
  applyType    String? // general | barrierfree | rental | sw
  hasPrior     Boolean? // 기존 수혜 이력
  priorType    String?
  // 유입 경로 — 링크에 ?src=sales|marketing 을 붙였을 때만 기록. 기존 링크는 null
  source       String?
  // 세부 채널 — ?by=meta, ?by=포스팅 처럼 적은 값이 그대로 들어간다. 값 목록은 고정하지 않는다
  sourceDetail String?
  // 접수 단계 — 시작 폼만 냈으면 start, 마지막 폼까지 제출하면 done
  stage        String             @default("start") // start | done
  status       String             @default("new") // new | checked | done
  memo         String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([roundId, phone])
  @@index([roundId, createdAt])
}

/// 인센티브 분기 데이터 — NBM(HW매출) 수기 입력 (이카운트 API에 손익 조회가 없어 수기 관리)
model ErpIncentiveQuarter {
  id           String   @id @default(cuid())
  year         Int
  quarter      Int
  hwSales      Json     @default("[]") // [월1, 월2, 월3] 이카운트 HW매출 공급가액
  rentalSales  Json     @default("[]") // [월1, 월2, 월3] 렌탈 매출
  channelUsage Json     @default("{}") // 상담자료 채널톡 활용 횟수 (수기) — {"Jo":220,"Jeff":180}
  settings     Json     @default("{}") // 분기별 규칙 값 (목표·요율·배분·가중치). 비면 기본값
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([year, quarter])
}

/// OPEN API 게이트웨이 접속 설정 — 단일 행(id="default")
model ErpOpenApiConfig {
  id           String   @id @default("default")
  baseUrl      String   @default("") // 예: https://openapi.broj.io
  masterPrefix String   @default("/BroJOpenAPI/v1")
  masterToken  String   @default("") // CRM 마스터 Bearer JWT (로그인으로 받음)
  sessionToken String   @default("") // SessionToken 헤더 (JWT와 함께 받음, 필수)
  publicApiKey String   @default("") // 공개 API용 API-KEY (센터 조회)

  // 마스터 로그인 — 토큰이 만료되면 이 정보로 다시 받아온다
  authBaseUrl    String    @default("https://brojserver.broj.co.kr")
  authPrefix     String    @default("/BroJServer/v1")
  authType       String    @default("EMAIL")
  memberId       String    @default("")
  memberPassword String    @default("") // SHA-256 hex만 저장 — 평문은 해싱 후 버린다
  tokenAt        DateTime?

  updatedBy String   @default("")
  updatedAt DateTime @updatedAt
}

/// 발급된 OPEN API Key 대장 — 게이트웨이에 전체 목록 API가 없어 ERP가 직접 기록한다.
/// api_key 원문은 발급 응답에서 한 번만 보여주고 저장하지 않는다 (prefix만 보관).
model ErpOpenApiKey {
  id         String    @id @default(cuid())
  keyId      String    @unique
  keyPrefix  String    @default("")
  name       String
  apiGrade   String    @default("CENTER") // SUPER | BRAND | CENTER
  brandKey   Int?
  groupKey   Int?
  brandId    String    @default("")
  groupId    String    @default("")
  centerName String    @default("")
  scopes     Json      @default("[]")
  groupKeys  Json      @default("[]") // 연결 센터 내부키 목록
  groupIds   Json      @default("[]") // 연결 센터 공개 ID 목록
  status     String    @default("ACTIVE") // ACTIVE | SUSPENDED | REVOKED
  expiredAt  DateTime?
  issuedBy   String    @default("")
  issuedAt   DateTime  @default(now())
  rotatedAt  DateTime?
  memo       String    @default("")
  updatedAt  DateTime  @updatedAt

  @@index([status])
  @@index([groupKey])
}

/// OPEN API Key 작업 기록 (발급·재발급·정지·폐기·센터 변경)
model ErpOpenApiKeyLog {
  id         String   @id @default(cuid())
  keyId      String
  keyName    String   @default("")
  centerName String   @default("")
  action     String // issue | rotate | suspend | revoke | tenants_add | tenants_replace | tenants_remove
  actorEmail String
  actorName  String
  before     String   @default("")
  after      String   @default("")
  detail     String   @default("")
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([keyId])
}

/// 센터 마스터 — 여정관리의 축. CRM 스냅샷을 하루 1회 받아 둔다.
/// 새로 쌓는 기록은 전부 groupKey로 매달리므로 이름 추측 매칭이 필요 없다.
model ErpCenter {
  groupKey       Int       @id
  name           String
  primaryName    String    @default("")
  bizNo          String    @default("")
  ownerName      String    @default("")
  ownerId        String    @default("")
  ownerPhone     String    @default("")
  phone          String    @default("")
  types          Json      @default("[]")
  paymentStatus  String    @default("")
  ticketName     String    @default("")
  ticketExpiredAt DateTime?
  ticketRegular  Boolean   @default(false)
  messagePoint   Int       @default(0)
  installTeam    String    @default("")
  kioskKeys      Json      @default("[]") // CRM이 주는 기종 boolean → 켜진 것만
  crmCreatedAt   DateTime?
  lastAccessedAt DateTime?
  memo           String    @default("")
  crmSyncedAt    DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([name])
  @@index([bizNo])
  @@index([paymentStatus])
}

/// 센터 통합 타임라인 — 영역별 상세는 각 테이블에 두고, 요약 한 줄만 여기 쌓는다.
/// 센터 카드는 이 테이블만 시간순으로 읽는다.
model ErpCenterEvent {
  id         String   @id @default(cuid())
  groupKey   Int
  occurredAt DateTime
  type       String // as | asset | point | sales | cx | crm
  title      String
  body       String   @default("")
  actorEmail String   @default("")
  actorName  String   @default("")
  team       String   @default("") // sales | cx | install | system
  refTable   String   @default("")
  refId      String   @default("")
  amount     Int?
  meta       Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([groupKey, occurredAt])
  @@index([type])
}

/// 문자포인트 일일 스냅샷 — 오른 날은 충전, 내린 만큼이 소진.
/// 결제주문내역을 붙이지 않기로 해서 충전 이력을 여기서 만든다.
model ErpCenterPointSnap {
  id       String   @id @default(cuid())
  groupKey Int
  date     String // YYYY-MM-DD (KST)
  point    Int
  delta    Int      @default(0) // 직전 스냅샷 대비
  createdAt DateTime @default(now())

  @@unique([groupKey, date])
  @@index([groupKey, date])
}

/// ERP 사용자별 브로제이 CRM 계정. 각자 자기 아이디로 붙는다 —
/// 누가 무엇을 조회했는지가 CRM 쪽에도 자기 계정으로 남는다.
/// 비밀번호는 SHA-256만 저장하고, 토큰은 호출할 때마다 갱신된다.
model ErpCrmAccount {
  id             String    @id @default(cuid())
  userEmail      String    @unique
  memberId       String
  memberPassword String    @default("") // SHA-256 hex
  masterToken    String    @default("")
  sessionToken   String    @default("") // 메일로 받은 6자리
  tokenAt        DateTime?
  lastError      String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// 센터에 설치된 키오스크 한 대. 시리얼로 기계의 일생을 잇는다 —
/// 센터를 옮기면 행을 새로 만들지 않고 groupKey를 바꾸고 movedFromGroupKey를 남긴다.
model ErpCenterAsset {
  id                String    @id @default(cuid())
  groupKey          Int
  kind              String // 기종 (21.5인치 · 32인치 · aPOS …)
  serial            String    @unique // 영문·숫자, 대문자로 통일해 저장
  installedAt       DateTime?
  warrantyUntil     DateTime? // 설치일 + 1년
  teamId            String    @default("")
  teamName          String    @default("") // 그때 값 스냅샷
  installer         String    @default("")
  status            String    @default("ACTIVE") // ACTIVE | REPAIR | SWAPPED | REMOVED
  location          String    @default("")
  removedAt         DateTime?
  movedFromGroupKey Int?
  note              String    @default("")
  createdEmail      String    @default("")
  createdName       String    @default("")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([groupKey])
  @@index([status])
  @@index([teamId])
}

/// AS 티켓. 종결 유형(무상·유상·리퍼교체·수리거절)이 통계의 축이다.
model ErpAsTicket {
  id       String @id @default(cuid())
  ticketNo String @unique // AS-260903-001
  groupKey Int

  assetId String @default("")
  serial  String @default("")

  receivedAt DateTime
  channel    String // kakao | phone
  symptom    String
  cause      String @default("")
  action     String @default("")

  status     String    @default("received") // received | assigned | visiting | closed
  teamId     String    @default("")
  teamName   String    @default("")
  technician String    @default("")
  visitedAt  DateTime?
  closedAt   DateTime?

  resolution   String  @default("") // free | paid | swap | rejected
  amount       Int?
  rejectReason String  @default("")
  swapOutSerial String @default("")
  swapInSerial  String @default("")
  /// 접수 시점에 보증 기간 안이었는지 — 나중에 설치일이 바뀌어도 판정이 흔들리지 않게 스냅샷
  warrantyAtReceipt Boolean?

  reopenOf     String   @default("") // 같은 증상 재접수면 원래 티켓 id
  note         String   @default("")
  createdEmail String   @default("")
  createdName  String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([groupKey, receivedAt])
  @@index([status])
  @@index([resolution])
  @@index([teamId])
}

/// 세일즈·CXM 접점. 기록 모양이 같아 한 테이블에 두고 team으로 나눈다.
model ErpCenterContact {
  id           String    @id @default(cuid())
  groupKey     Int
  team         String // sales | cx
  kind         String // 전화 · 방문 · 채널톡 · 메일 · 교육 …
  occurredAt   DateTime
  actorEmail   String    @default("")
  actorName    String    @default("")
  summary      String
  outcome      String    @default("")
  nextActionAt DateTime?
  nextAction   String    @default("")
  sentiment    String    @default("") // good | normal | bad
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([groupKey, occurredAt])
  @@index([team])
  @@index([nextActionAt])
}

/// 고객관리 센터조회 — 저장한 검색 조건(세그먼트). 클릭하면 그 조건으로 조회된다.
model ErpCrmSegment {
  id         String   @id @default(cuid())
  name       String
  filters    Json     @default("{}") // keyword·first·second·요금제·주요기록 등
  ownerEmail String
  ownerName  String   @default("")
  shared     Boolean  @default(false) // 켜면 팀 전체가 본다
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ownerEmail])
  @@index([shared])
}

/// 센터 대장 — 발급에 필요한 group_key(CRM 내부 정수키)와 공개 group_id를 함께 보관
model ErpOpenApiCenter {
  id         String   @id @default(cuid())
  groupKey   Int      @unique
  groupId    String   @default("")
  brandKey   Int?
  brandId    String   @default("")
  centerName String
  bizNo      String   @default("")
  source     String   @default("manual") // manual | request | groups_api
  memo       String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([centerName])
}
